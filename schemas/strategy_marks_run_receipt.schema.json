{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuanAgent Strategy Marks Run Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "workspace_id",
    "status",
    "workspace_path",
    "input_digest_ok",
    "mutation_errors",
    "artifact_sha256",
    "mark_count"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "strategy_marks_run_receipt_v1"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "workspace_path": {
      "type": "string",
      "minLength": 1
    },
    "input_digest_ok": {
      "type": "boolean"
    },
    "mutation_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_sha256": {
      "type": "object",
      "required": [
        "mark_points_json",
        "mark_points_csv",
        "marks_view_html"
      ],
      "properties": {
        "mark_points_json": {
          "type": "string"
        },
        "mark_points_csv": {
          "type": "string"
        },
        "marks_view_html": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "mark_count": {
      "type": "integer",
      "minimum": 0
    },
    "failure_reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
