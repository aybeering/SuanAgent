{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuanAgent Strategy Marks Run Request",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "workspace_id",
    "split",
    "market_csv",
    "strategy_module"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "strategy_marks_run_request_v1"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "type": "string",
      "enum": [
        "train",
        "validation",
        "holdout"
      ]
    },
    "market_csv": {
      "type": "string",
      "minLength": 1
    },
    "strategy_module": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
