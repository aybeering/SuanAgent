{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuanAgent Visual Agent Trace",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "workspace_id",
    "html_accepted",
    "html_count",
    "vision_mode",
    "script_command",
    "script_exit_code",
    "signal_count"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "visual_agent_trace_v1"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "html_accepted": {
      "type": "boolean"
    },
    "html_count": {
      "type": "integer",
      "minimum": 0
    },
    "vision_mode": {
      "type": "string",
      "enum": [
        "stub_empty"
      ]
    },
    "script_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "script_exit_code": {
      "type": "integer"
    },
    "signal_count": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
