{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuanAgent Visual Marks Run Request",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "workspace_id",
    "html_files",
    "marking_script",
    "agent_entry"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "visual_marks_run_request_v1"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "html_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "marking_script": {
      "type": "string",
      "const": "tools/write_mark_points.py"
    },
    "agent_entry": {
      "type": "string",
      "const": "agent/stub_visual_agent.py"
    }
  },
  "additionalProperties": false
}
